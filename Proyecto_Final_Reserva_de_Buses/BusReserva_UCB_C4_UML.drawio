<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-11-14T17:00:00.000Z" agent="ChatGPT - C4 y UML para BusReserva UCB con memoria temporal">
  <diagram id="mem_n1" name="C4 1 - Contexto">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1title" value="C4 Nivel 1 - Contexto del sistema" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#173B61;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="20" width="1000" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1student" value="&lt;b&gt;Estudiante UCB&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta salidas; reserva o cancela un cupo;&lt;br&gt;presenta carnet estudiantil físico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B61;fontColor=#FFFFFF;strokeColor=#173B61;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="155" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1staff" value="&lt;b&gt;Personal de transporte&lt;/b&gt;&lt;br&gt;[Administrador presencial]&lt;br&gt;Consulta lista de reservas, coteja carnet&lt;br&gt;y confirma el abordaje" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B61;fontColor=#FFFFFF;strokeColor=#173B61;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="730" y="155" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1sys" value="&lt;b&gt;BusReserva UCB&lt;/b&gt;&lt;br&gt;[Aplicación web en Java]&lt;br&gt;Organiza reservas por ruta, fecha y horario&lt;br&gt;para reducir la incertidumbre de las filas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2367A3;fontColor=#FFFFFF;strokeColor=#13507D;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="275" y="425" width="550" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p1note" value="&lt;b&gt;Problema:&lt;/b&gt; largas filas, calor, personas que se adelantan, riesgo de quedarse sin asiento y costos de transporte alternativo.&lt;br&gt;&lt;b&gt;Alcance de la demostración:&lt;/b&gt; datos simulados en memoria; cotejo manual del carnet; no se escanea el QR ni se almacenan fotos de carnets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;fontColor=#294A60;strokeColor=#A3BACD;arcSize=10;align=left;verticalAlign=middle;spacing=14;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="660" width="900" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p1e1" value="Reserva / consulta" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#638198;strokeWidth=1.5;fontSize=12;fontColor=#4D667A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="p1student" target="p1sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e2" value="Lista / valida abordaje" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#638198;strokeWidth=1.5;fontSize=12;fontColor=#4D667A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="p1staff" target="p1sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mem_n2" name="C4 2 - Contenedores">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1130" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2title" value="C4 Nivel 2 - Contenedores de la aplicacion" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#173B61;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="20" width="1040" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2stu" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;[Persona]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B61;fontColor=#FFFFFF;strokeColor=#173B61;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="140" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2staff" value="&lt;b&gt;Personal de transporte&lt;/b&gt;&lt;br&gt;[Administrador]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B61;fontColor=#FFFFFF;strokeColor=#173B61;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2nav" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;[Celular o PC]&lt;br&gt;Páginas HTML y formularios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5C6974;fontColor=#FFFFFF;strokeColor=#3C4F5F;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="385" y="155" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2lim" value="Sistema BusReserva UCB - un solo proceso Java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontColor=#4D667A;strokeColor=#A3BACD;dashed=1;dashPattern=8 6;arcSize=8;align=left;verticalAlign=top;spacingTop=10;spacingLeft=15;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="180" y="375" width="760" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p2app" value="&lt;b&gt;Aplicación web&lt;/b&gt;&lt;br&gt;[Java 21 + Javalin]&lt;br&gt;Horarios, reservas, lista de pasajeros y validación presencial.&lt;br&gt;Guarda usuarios, viajes y reservas en Map / List de Java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2367A3;fontColor=#FFFFFF;strokeColor=#13507D;strokeWidth=1.5;arcSize=12;align=center;verticalAlign=middle;spacing=10;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="285" y="460" width="550" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2inside" value="&lt;b&gt;Memoria temporal:&lt;/b&gt; los registros son compartidos por quienes acceden al mismo servidor Java. Se pierden cuando se reinicia el programa. No hay MySQL, JDBC ni servicio de base de datos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;fontColor=#294A60;strokeColor=#A3BACD;arcSize=10;align=left;verticalAlign=middle;spacing=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="665" width="660" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2note" value="&lt;b&gt;Decisión técnica:&lt;/b&gt; el almacenamiento es una parte interna de la aplicación, no un contenedor independiente. Una versión real de producción necesitaría persistencia, control de acceso institucional y un procedimiento oficial de embarque." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;fontColor=#294A60;strokeColor=#A3BACD;arcSize=10;align=left;verticalAlign=middle;spacing=14;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="775" width="890" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2e1" value="Reserva desde celular" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#638198;strokeWidth=1.5;fontSize=12;fontColor=#4D667A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="p2stu" target="p2nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e2" value="Control en parada" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#638198;strokeWidth=1.5;fontSize=12;fontColor=#4D667A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="p2staff" target="p2nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e3" value="HTTP - interfaz web" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeColor=#638198;strokeWidth=1.5;fontSize=12;fontColor=#4D667A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="p2nav" target="p2app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mem_n3" name="C4 3 - Componentes">
